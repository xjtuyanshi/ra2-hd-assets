{
  "name": "ra2-assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local HD-cache extraction from the player's own RA2/YR install: map terrain/sprite atlases, palettes, voxels and a manifest for the HD renderer. Output is derived game data and stays in the gitignored gameres/.",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": "./src/index.ts",
    "./manifest": "./src/manifest.ts",
    "./waterMask": "./src/waterMask.ts",
    "./library": "./src/library.ts",
    "./lights": "./src/lights.ts",
    "./windows": "./src/windows.ts"
  },
  "scripts": {
    "prepare-map": "node --import tsx src/cli/prepareMap.mts",
    "extract": "tsx src/cli/extract.mts",
    "preview": "tsx src/cli/preview.mts",
    "terrain-map": "tsx src/cli/terrainMap.mts",
    "upscale": "tsx src/cli/upscale.mts",
    "sprites": "tsx src/cli/sprites.mts",
    "library": "tsx src/cli/library.mts",
    "lights": "tsx src/cli/lights.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ra2-formats": "workspace:*"
  }
}
